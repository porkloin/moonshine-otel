    {
      "type": "timeseries",
      "title": "Stage p99",
      "description": "consumer_queue is a sub-interval of encode_wait. unaccounted = total minus the sequential stages.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (stage) (rate(moonshine_frame_stage_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"$frame_kind\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "format": "time_series"
