    {
      "type": "timeseries",
      "title": "Mean stage breakdown (stacked)",
      "description": "Sequential stages plus unaccounted; the stack height is the mean total latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_avg(sum by (stage) (rate(moonshine_frame_stage_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"delta|key\", stage!=\"consumer_queue\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
