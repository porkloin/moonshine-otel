{
  "uid": "moonshine-live",
  "title": "Moonshine: live pipeline",
  "description": "Where frame time goes, live. Exact per-run percentiles are in the result JSON and on bench.run spans.",
  "tags": [
    "moonshine",
    "moonshine-otel"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(moonshine_frames_total, run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(moonshine_frames_total, run_id)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "codec",
        "label": "Codec",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(moonshine_frames_total{run_id=~\"$run_id\"}, codec)",
          "refId": "codec"
        },
        "definition": "label_values(moonshine_frames_total{run_id=~\"$run_id\"}, codec)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "frame_kind",
        "label": "Frame kind",
        "type": "custom",
        "query": "delta,key,idr_reencode",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "delta",
            "value": "delta",
            "selected": false
          },
          {
            "text": "key",
            "value": "key",
            "selected": false
          },
          {
            "text": "idr_reencode",
            "value": "idr_reencode",
            "selected": false
          }
        ],
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "rgba(80, 140, 255, 0.25)",
        "expr": "group by (run_id) (increase(moonshine_frames_total{run_id=~\"$run_id\"}[30s]) > 0)",
        "step": "15s",
        "titleFormat": "run {{run_id}}",
        "tagKeys": "run_id",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Headline (captured frames, over the selected range)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Total p99",
      "description": "Exact per-run numbers are in the result JSON; this is from Prometheus native histograms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(moonshine_frame_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"delta|key\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
