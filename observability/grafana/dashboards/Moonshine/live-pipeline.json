    {
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Total latency by frame kind",
      "description": "idr_reencode frames skip capture, import and convert; compare them separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (frame_kind) (rate(moonshine_frame_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"$frame_kind\"}[$__rate_interval])))",
          "legendFormat": "{{frame_kind}} p50",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (frame_kind) (rate(moonshine_frame_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"$frame_kind\"}[$__rate_interval])))",
          "legendFormat": "{{frame_kind}} p95",
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (frame_kind) (rate(moonshine_frame_duration_seconds{run_id=~\"$run_id\", codec=~\"$codec\", frame_kind=~\"$frame_kind\"}[$__rate_interval])))",
          "legendFormat": "{{frame_kind}} p99",
          "refId": "C",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "id": 9
