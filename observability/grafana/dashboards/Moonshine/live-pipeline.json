      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(moonshine_encoded_bytes_total{run_id=~\"$run_id\", codec=~\"$codec\"}[1m])) * 8 / 1e6",
