{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "moonshine-otel",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        "Cargo.toml",
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='moonshine-otel')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='moonshine-otel-exporter')].version"
        }
      ]
    }
  }
}
